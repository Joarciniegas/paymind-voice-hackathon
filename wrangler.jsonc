// Worker «paymind-voice-hackathon»: PayMind Voice con Muse Spark (Meta Model API).
// Twilio ConversationRelay abre un WebSocket aquí (wss://…/ws), nos manda lo que
// dice el comprador ya transcrito y respondemos texto que Twilio convierte en voz.
// Despliegue: npx wrangler deploy
// Secretos (wrangler secret put): MODEL_API_KEY (Meta Model API) y VOICE_KEY (firma HMAC).
// Nunca se ponen secretos en este archivo: el repo es público.
{
  "name": "paymind-voice-hackathon",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // Hackathon: solo datos ficticios (src/demo-data.ts), nunca el backend real de PayMind.
  "vars": { "DEMO": "1" },
  "observability": { "enabled": true }
}
